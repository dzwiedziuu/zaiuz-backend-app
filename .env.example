# Baza PostgreSQL; schemat tworzą migracje Flyway przy pierwszym starcie.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/zaiuz
SPRING_DATASOURCE_USERNAME=zaiuz
SPRING_DATASOURCE_PASSWORD=zmien-mnie

# Konto administratora tworzone przy pierwszym starcie (gdy w bazie nie ma żadnego użytkownika).
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=zmien-mnie-2

# --- Generator danych (generator/) -------------------------------------------------------
# Adres aplikacji, do której generator wysyła wyniki.
API_URL=http://localhost:8080
# Klucz API czujnika, wyświetlany jednorazowo przy rejestracji czujnika.
SENSOR_API_KEY=
# Dane administratora dla skryptu danych przykładowych (seed-sample-data.mjs).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=zmien-mnie-2
